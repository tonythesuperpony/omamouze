#!/usr/bin/env python3
"""OmaMouze controller: hardware detection, DPI, buttons, cursor size, and scroll speed."""
import sys
import os
import json
import re
import subprocess
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "omamouze"
CONFIG_FILE = CONFIG_DIR / "config.json"
STATE_DIR = Path.home() / ".local" / "state" / "omamouze"
BINDINGS_LUA = STATE_DIR / "bindings.lua"
LOOKNFEEL_LUA = Path.home() / ".config" / "hypr" / "looknfeel.lua"

PRESET_ACTIONS = [
    # Navigation
    {"category": "Navigation", "id": "nav_back", "label": "Browser Back", "cmd": "wtype -M alt -k Left -m alt"},
    {"category": "Navigation", "id": "nav_fwd", "label": "Browser Forward", "cmd": "wtype -M alt -k Right -m alt"},
    {"category": "Navigation", "id": "nav_reload", "label": "Reload Page", "cmd": "wtype -M ctrl -k r -m ctrl"},
    {"category": "Navigation", "id": "nav_tab_next", "label": "Next Tab", "cmd": "wtype -M ctrl -k Tab -m ctrl"},
    {"category": "Navigation", "id": "nav_tab_prev", "label": "Previous Tab", "cmd": "wtype -M ctrl -M shift -k Tab -m shift -m ctrl"},
    {"category": "Navigation", "id": "nav_tab_new", "label": "New Tab", "cmd": "wtype -M ctrl -k t -m ctrl"},
    {"category": "Navigation", "id": "nav_tab_close", "label": "Close Tab", "cmd": "wtype -M ctrl -k w -m ctrl"},
    
    # Window Management
    {"category": "Window", "id": "win_close", "label": "Close Window", "cmd": "hyprctl dispatch killactive"},
    {"category": "Window", "id": "win_fullscreen", "label": "Toggle Fullscreen", "cmd": "hyprctl dispatch fullscreen 0"},
    {"category": "Window", "id": "win_float", "label": "Toggle Floating", "cmd": "hyprctl dispatch togglefloating"},
    {"category": "Window", "id": "win_pin", "label": "Pin Window (All Workspaces)", "cmd": "hyprctl dispatch pin"},
    
    # Workspaces
    {"category": "Workspace", "id": "ws_next", "label": "Next Workspace", "cmd": "hyprctl dispatch workspace m+1"},
    {"category": "Workspace", "id": "ws_prev", "label": "Previous Workspace", "cmd": "hyprctl dispatch workspace m-1"},
    
    # Media & Sound
    {"category": "Media", "id": "media_play_pause", "label": "Play / Pause", "cmd": "playerctl play-pause"},
    {"category": "Media", "id": "media_next", "label": "Next Track", "cmd": "playerctl next"},
    {"category": "Media", "id": "media_prev", "label": "Previous Track", "cmd": "playerctl previous"},
    {"category": "Media", "id": "vol_up", "label": "Volume Up (+5%)", "cmd": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"},
    {"category": "Media", "id": "vol_down", "label": "Volume Down (-5%)", "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"},
    {"category": "Media", "id": "vol_mute", "label": "Mute / Unmute", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"},
    
