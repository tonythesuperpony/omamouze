    {"category": "System", "id": "sys_screenshot", "label": "Screenshot", "cmd": "omarchy-capture-screenshot"},
    {"category": "System", "id": "sys_terminal", "label": "Open Terminal", "cmd": "omarchy launch terminal"},
    {"category": "System", "id": "sys_menu", "label": "Omarchy Menu", "cmd": "omarchy-menu toggle root"},
